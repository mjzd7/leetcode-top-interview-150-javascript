# ---------------------------------------------------------------------------
# AI chat widget (/api/chat). Copy to .env.local for local development.
# .env* is gitignored, so this file is the only place these names are recorded.
# ---------------------------------------------------------------------------

# REQUIRED for the assistant to work. Without it /api/chat returns
# 503 { "error": "Chat is not configured" } — by design, it fails loudly.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Defaults to https://api.openai.com/v1. Point this at any
# OpenAI-compatible gateway (OpenRouter, Together, a local vLLM) to use a
# different provider. Must be a REST/HTTP base URL, not an OCI/vLLM port URL.
AI_BASE_URL=

# Optional. Defaults to gpt-4o-mini. Set to switch models, e.g. gpt-4o-mini
# is the cheapest sensible option for study help; gpt-4o is stronger but dearer.
AI_MODEL=gpt-4o-mini

# Optional. Comma-separated allowlist of browser origins permitted to call
# /api/chat, e.g. https://your-user.github.io. Supports a leading wildcard on a
# single label (e.g. *.vercel.app covers every Preview deployment).
# Same-origin requests are allowed automatically; a request with no Origin and
# no Referer header is allowed too. See CHATBOX_PROGRESS.md decision D-5.
CHAT_ALLOWED_ORIGINS=

# Optional. Powers the web_search and fetch_page tools. WITHOUT it the assistant
# still searches all 175 of this manual's own guides (search_guides, which is
# free and always available) — it just cannot reach the open internet, and it is
# told so rather than left to guess.
#
# Free tier: 1,000 credits/month, resets on the 1st, no credit card required
# (https://tavily.com/#pricing). Search costs 2 credits per 10 results and a
# scrape 1 credit per page, so the quota goes a long way if the assistant is
# told to prefer the manual — which the system prompt does.
#
# This is a SHARED, PER-ACCOUNT quota on a public site. If it runs out, the tools
# fail soft: the assistant says the lookup did not happen and answers from the
# guides instead of breaking.
TAVILY_API_KEY=

# Optional, for distributed rate limiting (5 requests/minute per IP).
# If unset, the route falls back to a per-instance in-memory limiter, which is
# weaker on serverless but still bounded. This project already provisions
# KV_REST_API_URL / KV_REST_API_TOKEN for the judge feature, so you usually
# need nothing extra here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Already provisioned for the judge feature; listed here because the chat
# route also reads them (Vercel KV is Upstash-over-REST).
# ---------------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
SESSION_SECRET=

# ---------------------------------------------------------------------------
# GitHub login — the ONLY login path in this project (MASTER_PLAN.md §6, D2).
# No other provider is supported or planned: no Google, no email/password, no
# magic link, no SSO, no cookie import.
#
# Create the OAuth App yourself at https://github.com/settings/developers:
#   Homepage URL           -> https://<your-vercel-domain>
#   Authorization callback -> https://<your-vercel-domain>/api/auth/callback
# Scope is fixed at `read:user` in api/auth/login.mjs and cannot be widened
# from here. The client SECRET must only ever live in Vercel env vars — never
# in this file, never in git, never in a chat transcript.
# ---------------------------------------------------------------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Canonical public origin for the OAuth callback (hardening A-1). When set, the
# login routes use this instead of trusting x-forwarded-host, which is
# attacker-influenceable outside Vercel. Leave blank to fall back to request
# headers (the current behaviour).
PUBLIC_ORIGIN=

# Bump to invalidate every outstanding session cookie at once (hardening A-3).
# Sessions are stateless, so this is the only available kill switch: change the
# value and all previously signed cookies stop verifying. Anything that is not
# an integer >= 1 falls back to 1, so a typo here never reads as "log everyone
# out" — the deploy that first sets this does not invalidate existing cookies.
SESSION_EPOCH=1

# Set to 1 when this deployment is served over TLS but is not Vercel production
# (a preview, a self-hosted box behind a proxy). It is the single rule that
# decides whether the session cookie and the OAuth `state` cookie both carry
# `Secure`; VERCEL_ENV=production already implies it. One rule, both cookies —
# a second copy of this predicate is a second policy that will drift.
COOKIE_SECURE=
