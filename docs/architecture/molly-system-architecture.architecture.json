      "dot": "emerald",
      "title": "Robust Streaming AI Assistant",
      "items": [
        "Stable split markdown rendering: breaks at last blank line, eliminating streaming layout thrashing",
        "Wall-clock budget protection: 52s total timeout guard under Vercel 60s hard ceiling",
        "15s tool reserve: rejects tool calls when time is low to guarantee delivery of a complete prose answer",
        "10s heartbeat comment: prevents reverse proxy and edge connection drops during silent inference"
      ]
    },
    {
      "dot": "amber",
      "title": "AST Instrumentation & Sandbox Tracing",
      "items": [
        "Depth-free region alignment: prevents empty traces for 102 self-recursive solution blocks",
        "Acorn AST traversal: probes attached by exact source slice, guaranteeing code/offset parity",
        "QuickJS-Emscripten WASM: hermetic sandbox execution preventing prototype pollution and host memory leaks",
        "Envelope v1.1 schema validation: strict JSON schema assertion guaranteeing flawless dry-run replay"
      ]
    },
    {
      "dot": "rose",
      "title": "Fail-Closed Quality Gates",
      "items": [
        "Cryptographic CSP enforcement: exact SHA-256 script hashing without 'unsafe-inline' in vercel.json",
        "Playwright E2E verification: automated WCAG 2.1 AA luminance scanning over transparent DOM ancestors",
        "Mobile layout invariants: rigid 56px header height and 40px touch targets tested down to 360px viewport",
        "Automated deployment safety: builds require passing all 278 unit assertions, golden traces, and E2E suites"
