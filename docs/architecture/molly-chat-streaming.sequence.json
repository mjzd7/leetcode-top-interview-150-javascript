  "cards": [
    {
      "dot": "cyan",
      "title": "Layout Thrashing Elimination",
      "items": [
        "stableSplit() finds the last blank line outside code fences",
        "paintReveal() parses Markdown ONLY when the stable boundary moves (once per paragraph)",
        "The live tail is updated via single textContent writes, running at 60fps with zero layout reflows"
      ]
    },
    {
      "dot": "emerald",
      "title": "Wall-Clock Time Budgeting",
      "items": [
        "Vercel serverless platform limit is hard-capped at 60 seconds",
        "Route enforces TOTAL_BUDGET_MS = 52s, leaving 8s headroom to emit clean tail error frames",
        "15s tool reserve prevents starting external tools (e.g. web search) that would time out before prose answers"
      ]
    },
    {
      "dot": "rose",
      "title": "Reverse Proxy Keepalive",
      "items": [
        "During long LLM 'thinking' phases, proxies (Cloudflare, Vercel) sever idle connections after 15s",
        "A 10s setInterval timer emits SSE comments (: ping), keeping TCP sockets warm without altering payload",
        "Client parser ignores SSE comments, maintaining pure byte-for-byte JSON streaming integrity"
      ]
    }
  ]
}
