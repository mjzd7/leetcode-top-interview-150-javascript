    { "participant": "widget", "from": 165, "to": 700, "type": "frontend" },
    { "participant": "api", "from": 200, "to": 665, "type": "backend" },
    { "participant": "limiter", "from": 235, "to": 275, "type": "security" },
    { "participant": "budget", "from": 305, "to": 345, "type": "backend" },
    { "participant": "llm", "from": 375, "to": 625, "type": "cloud" },
    { "participant": "dom", "from": 515, "to": 700, "type": "frontend" }
