  "01-array-string/06-rotate-array.md": {
    "script": "const rotated = (nums, k) => { rotate(nums, k); return nums; };\nassertEq(rotated([1, 2, 3, 4, 5, 6, 7], 3), [5, 6, 7, 1, 2, 3, 4], 'problem statement example, three steps');\nassertEq(rotated([1, 2, 3, 4], 2), [3, 4, 1, 2], 'Level 3 dry run');\nassertEq(rotated([1, 2], 5), [2, 1], 'edge: k greater than array length');\nassertEq(rotated([1, 2, 3], 3), [1, 2, 3], 'edge: k equals n is a no-op');\nassertEq(rotated([1], 99), [1], 'edge: single element array');\nassertEq(rotated([1, 2], 1), [2, 1], 'edge: two elements');\nconsole.log('ASSERT-OK 6');"
  },
