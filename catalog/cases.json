  "01-array-string/12-insert-delete-getrandom-o1.md": {
    "script": "const REAL_RANDOM = Math.random;\nconst DRAWS = [0, 0.75, 0.999999];\nlet draw = 0;\nMath.random = () => DRAWS[draw++ % DRAWS.length];\nconst resetDraws = () => { draw = 0; };\n\nresetDraws();\nconst ex1 = new RandomizedSet();\nconst out1 = [ex1.insert(1), ex1.remove(2), ex1.insert(2)];\nout1.push(ex1.getRandom());\nout1.push(ex1.remove(1));\nout1.push(ex1.insert(2));\nout1.push(ex1.getRandom());\nassertEq(out1, [true, false, true, 1, true, false, 2], 'example 1 op sequence under the fixed draw sequence');\n\nresetDraws();\nconst dry = new RandomizedSet();\ndry.insert(10);\ndry.insert(20);\ndry.insert(30);\ndry.remove(20);\nassertEq(dry.getRandom(), 10, 'Level 3 dry run: draw 0 picks index 0 of [10, 30]');\nassertEq(dry.getRandom(), 30, 'Level 3 dry run: draw 0.75 picks the last index of [10, 30]');\n\nconst lastOnly = new RandomizedSet();\nlastOnly.insert(1);\nassertEq(lastOnly.remove(1), true, 'edge: removing the last element in the array');\n\nconst absent = new RandomizedSet();\nabsent.insert(1);\nassertEq(absent.remove(5), false, 'edge: removing a non-existent value');\n\nconst churn = new RandomizedSet();\nassertEq([churn.insert(1), churn.remove(1), churn.insert(1)], [true, true, true], 'edge: consecutive inserts and deletes');\n\nresetDraws();\nconst single = new RandomizedSet();\nsingle.insert(10);\nassertEq([single.getRandom(), single.getRandom(), single.getRandom()], [10, 10, 10], 'edge: single element getRandom is draw-independent');\n\nMath.random = REAL_RANDOM;\nconsole.log('ASSERT-OK 7');"
  },
