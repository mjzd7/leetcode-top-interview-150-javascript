{
  "01-array-string/01-merge-sorted-array.md": {
    "script": "const merged = (nums1, m, nums2, n) => { merge(nums1, m, nums2, n); return nums1; };\nassertEq(merged([1, 2, 3, 0, 0, 0], 3, [2, 5, 6], 3), [1, 2, 2, 3, 5, 6], 'problem statement example');\nassertEq(merged([1, 3, 0, 0], 2, [2, 4], 2), [1, 2, 3, 4], 'Level 3 dry run');\nassertEq(merged([1], 1, [], 0), [1], 'edge: nums2 empty (n=0)');\nassertEq(merged([0], 0, [1], 1), [1], 'edge: nums1 initial elements empty (m=0)');\nassertEq(merged([4, 5, 6, 0, 0, 0], 3, [1, 2, 3], 3), [1, 2, 3, 4, 5, 6], 'edge: all nums2 smaller than nums1');\nassertEq(merged([2, 2, 0, 0], 2, [2, 2], 2), [2, 2, 2, 2], 'edge: duplicate / identical numbers');\nconsole.log('ASSERT-OK 6');"
  },
