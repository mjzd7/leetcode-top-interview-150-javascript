# Raw video downloads (regenerable via yt-dlp; exceed GitHub's 100MB/file limit)
00-foundations/video-transcripts/*/download/

# Agent working state (session continuations, not curriculum content)
.omo/

# Firecrawl research cache (regenerable JSON/MD snapshots, not curriculum content)
.firecrawl/

# Dependencies
node_modules/

# OS / editor noise
.DS_Store
Thumbs.db
*.log

# Dry-run engine build artifacts (regenerable: `node scripts/gen-blocks.mjs`, and the
# cached instrumented blocks row 9 writes beside them). A manifest is derived from the
# guides, so committing it means every guide edit lands a second, 450-entry diff.
build/

# Generated web bundle (rebuilt by CI via `npm run build` and locally as needed)
docs/curriculum-data.js
# Generated retrieval index for the chat's search_guides tool — same deal, and 3MB
# of derived JSON in git on every guide edit is a bad trade. Regenerated by
# `npm run build`; `includeFiles` in vercel.json ships it to the function.
api/_lib/guide-index.json
.vercel
.env*
!.env.example
opencode.json

# Agent scratch: QA screenshots, throwaway diagnostics, session notes
scratch/

# Playwright run artifacts (traces, screenshots on failure)
test-results/
playwright-report/

# Downloaded headless browser binaries (@mermaid-js/mermaid-cli pulls puppeteer)
.puppeteer_cache/
