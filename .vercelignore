# Never deploy raw media, agent scratch, or local installs.
# (Git already ignores most of these via .gitignore; the Vercel CLI needs its
# own list, and anything missing from it is uploaded.)
node_modules
.omo
.git
.codegraph
.puppeteer_cache
.firecrawl
scratch
test-results
playwright-report
*.log

